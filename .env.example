# Tourism inquiry form delivery.
# Set this to an HTTPS webhook (e.g. a Formspree, Make, Zapier, or LGU email-relay endpoint)
# that accepts a JSON POST. Without it, inquiries are only logged in development and
# rejected with a clear message in production.
INQUIRY_WEBHOOK_URL=

# Public site URL used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
