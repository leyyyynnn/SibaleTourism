# ---- Tourism inquiry form ----
# Web3Forms access key from https://web3forms.com. Inquiries are emailed to the
# address the key was created for. This key is designed to be public: it can only
# send to that one inbox. To change the inbox, create a new key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional fallback (server-side only): an HTTPS webhook that accepts a JSON POST.
# Used only when the Web3Forms key is not set.
INQUIRY_WEBHOOK_URL=

# Public site URL used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
